{
  "name": "hemusic",
  "productName": "HE-Music",
  "version": "2.0.5",
  "description": "A multi-platform online music player based on SPlayer.",
  "packageManager": "pnpm@10.28.1",
  "author": "he-music",
  "home": "https://hmusic.top",
  "github": "https://github.com/he-music/HE-Music",
  "blog": "https://hmusic.top",
  "repository": "github:he-music/HE-Music",
  "license": "AGPL-3.0",
  "license-file": "LICENSE",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=10",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "test": "vitest run",
    "test:core": "vitest run src/bootstrap src/core/audio-player src/utils/player src/utils/playbackRecovery src/utils/audioManager src/utils/songManager src/platform/downloadedPlayback src/platform/librarySync src/platform/localFilesSession src/stores/localPlaylists src/utils/lyricManager src/platform/localMetadata src/platform/localDownloadSession src/platform/applicationQuit src/composables/shellUpdates src/components/UI/VirtualScroll",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:ci": "go mod verify && pnpm check:runtime && pnpm lint:check && pnpm typecheck && pnpm test && pnpm test:desktop:build && pnpm test:desktop:release && pnpm test:desktop:mpv && pnpm lint:go && go test ./... && pnpm build:web",
    "lint": "pnpm exec eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "lint:go": "mise x golangci-lint@2.15.0 -- golangci-lint run -c .golangci.yml --allow-parallel-runners --timeout=10m",
    "format:go": "mise x golangci-lint@2.15.0 -- golangci-lint fmt -c .golangci.yml",
    "fix:go": "mise x golangci-lint@2.15.0 -- golangci-lint run -c .golangci.yml --allow-parallel-runners --timeout=10m --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "pnpm dev:desktop",
    "dev": "pnpm dev:desktop",
    "build": "pnpm run typecheck && node scripts/mygo.mjs build -sign - -skip-dmg -skip-notarize",
    "dev:web": "vite --config vite.config.ts",
    "preview:web": "vite preview --config vite.config.ts",
    "build:web": "pnpm run typecheck:web && vite build --config vite.config.ts",
    "dev:desktop:frontend": "vite --config vite.desktop.config.ts",
    "build:desktop:frontend": "pnpm run typecheck:web && vite build --config vite.desktop.config.ts",
    "dev:desktop": "node scripts/mygo.mjs dev",
    "generate:desktop": "node scripts/mygo.mjs generate",
    "build:desktop:mac": "node scripts/mygo.mjs build -platform darwin/arm64 -skip-dmg -skip-notarize -sign -",
    "build:desktop:win": "node scripts/mygo.mjs build -platform windows/amd64",
    "build:desktop:linux": "node scripts/mygo.mjs build -platform linux/amd64",
    "release:desktop:check": "node scripts/package/mygo-release.mjs --check-only",
    "release:desktop:verify": "node scripts/package/mygo-release.mjs --verify-artifacts",
    "release:desktop:build": "node scripts/package/mygo-release.mjs --build",
    "test:desktop:build": "node --test scripts/mygo.test.mjs",
    "test:desktop:release": "node --test scripts/package/mygo-release*.test.mjs",
    "mpv:prepare": "node scripts/mpv/resources.mjs",
    "mpv:check": "node scripts/mpv/resources.mjs --check",
    "test:desktop:mpv": "python3 -m unittest discover -s scripts/mpv -p '*_test.py' && node --test scripts/mpv/*.test.mjs",
    "build:win": "pnpm run build:desktop:win",
    "build:mac": "pnpm run build:desktop:mac",
    "build:linux": "pnpm run build:desktop:linux"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.6.0",
    "@applemusic-like-lyrics/lyric": "^1.1.0",
    "@cap.js/widget": "0.1.63",
    "@chenglou/pretext": "1.0.0",
    "@material/material-color-utilities": "^0.4.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.5.0",
    "github-markdown-css": "^5.9.0",
    "go-captcha-vue": "^2.0.7",
    "hls.js": "^1.7.4",
    "i18next": "^27.2.1",
    "js-cookie": "^3.0.8",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "localforage": "^1.10.0",
    "lodash-es": "^4.18.1",
    "lucide": "1.76.0",
    "marked": "^18.2.1",
    "md5": "^2.3.0",
    "mygo-runtime": "0.10.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pixi.js": "8.23.0",
    "plyr": "^3.8.5",
    "vue-dompurify-html": "^5.3.0",
    "vue-i18n": "^11.4.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.14.0",
    "mygo-cli": "0.10.0",
    "naive-ui": "^2.45.3",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "terser": "^5.51.2",
    "typescript": "6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@applemusic-like-lyrics/core",
      "@applemusic-like-lyrics/lyric",
      "@applemusic-like-lyrics/vue",
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "vue-demi"
    ],
    "patchedDependencies": {
      "@applemusic-like-lyrics/core@0.6.0": "patches/@applemusic-like-lyrics__core@0.6.0.patch"
    }
  }
}
