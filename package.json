{
  "name": "hemusic",
  "productName": "HE-Music",
  "version": "1.0.3",
  "description": "A multi-platform online music player based on SPlayer.",
  "packageManager": "pnpm@10.28.1",
  "main": "./out/main/index.js",
  "author": "he-music",
  "home": "https://hmusic.top",
  "github": "https://github.com/he-music/HE-Music",
  "blog": "https://hmusic.top",
  "repository": "github:he-music/HE-Music",
  "license": "AGPL-3.0",
  "license-file": "LICENSE",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=10",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "test": "vitest run",
    "lint": "npx eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "node scripts/dev.mjs",
    "build": "npx rimraf dist && pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:web": "pnpm run build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win --config electron-builder.config.ts --publish never",
    "build:mac": "pnpm run build && electron-builder --mac --config electron-builder.config.ts --publish never",
    "build:linux": "pnpm run build && electron-builder --linux --config electron-builder.config.ts --publish never"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.5.2",
    "@applemusic-like-lyrics/lyric": "^1.1.0",
    "@cap.js/widget": "0.1.58",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@imsyy/color-utils": "^1.0.2",
    "@material/material-color-utilities": "^0.3.0",
    "@neteasecloudmusicapienhanced/api": "^4.41.1",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.20.0",
    "change-case": "^5.4.4",
    "dayjs": "^1.11.23",
    "electron-dl": "^4.0.0",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.10",
    "file-saver": "^2.0.5",
    "font-list": "^2.1.0",
    "fuse.js": "^7.5.0",
    "get-port": "^7.2.0",
    "github-markdown-css": "^5.9.0",
    "go-captcha-vue": "^2.0.7",
    "hls.js": "^1.7.3",
    "i18next": "^25.10.10",
    "js-cookie": "^3.0.8",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "localforage": "^1.10.0",
    "lodash-es": "^4.18.1",
    "marked": "^16.4.2",
    "md5": "^2.3.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "plyr": "^3.8.5",
    "vue-dompurify-html": "^5.3.0",
    "vue-i18n": "^11.4.13"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/http-proxy": "^11.6.4",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "ajv": "^8.20.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.17.0",
    "electron-log": "^5.4.4",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "fast-glob": "^3.3.3",
    "fastify": "^5.12.5",
    "naive-ui": "^2.45.3",
    "node-taglib-sharp": "^6.0.3",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "terser": "^5.51.2",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^7.3.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vue-tsc": "3.3.12"
  },
  "pnpm": {
    "overrides": {
      "dmg-builder": "26.17.0",
      "electron-builder-squirrel-windows": "26.17.0"
    },
    "onlyBuiltDependencies": [
      "@applemusic-like-lyrics/core",
      "@applemusic-like-lyrics/lyric",
      "@applemusic-like-lyrics/vue",
      "@parcel/watcher",
      "core-js",
      "electron",
      "electron-winstaller",
      "esbuild",
      "sharp",
      "vue-demi"
    ]
  }
}
