{
  "name": "hemusic",
  "productName": "HE-Music",
  "version": "2.0.2",
  "description": "A multi-platform online music player based on SPlayer.",
  "packageManager": "pnpm@10.28.1",
  "author": "he-music",
  "home": "https://hmusic.top",
  "github": "https://github.com/he-music/HE-Music",
  "blog": "https://hmusic.top",
  "repository": "github:he-music/HE-Music",
  "license": "AGPL-3.0",
  "license-file": "LICENSE",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=10",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "test": "vitest run",
    "check:runtime": "node scripts/check-runtime.mjs",
    "lint": "npx eslint . --fix",
    "lint:go": "mise x golangci-lint@2.15.0 -- golangci-lint run -c .golangci.yml --allow-parallel-runners --timeout=10m",
    "format:go": "mise x golangci-lint@2.15.0 -- golangci-lint fmt -c .golangci.yml",
    "fix:go": "mise x golangci-lint@2.15.0 -- golangci-lint run -c .golangci.yml --allow-parallel-runners --timeout=10m --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "pnpm dev:desktop",
    "dev": "pnpm dev:desktop",
    "build": "pnpm run typecheck && node scripts/vendor/mygo.mjs build -sign - -skip-dmg -skip-notarize",
    "dev:web": "vite --config vite.config.ts",
    "preview:web": "vite preview --config vite.config.ts",
    "build:web": "pnpm run typecheck:web && vite build --config vite.config.ts",
    "dev:desktop:frontend": "vite --config vite.desktop.config.ts",
    "build:desktop:frontend": "pnpm run typecheck:web && vite build --config vite.desktop.config.ts",
    "vendor:check": "node scripts/vendor/mygo.mjs check",
    "vendor:refresh": "node scripts/vendor/mygo.mjs refresh",
    "test:desktop:vendor": "node --test scripts/vendor/*.test.mjs",
    "test:desktop:windows-sdk": "node scripts/vendor/mygo.mjs test-windows",
    "dev:desktop": "node scripts/vendor/mygo.mjs dev",
    "generate:desktop": "node scripts/vendor/mygo.mjs generate",
    "build:desktop:mac": "node scripts/vendor/mygo.mjs build -platform darwin/arm64 -skip-dmg -skip-notarize -sign -",
    "build:desktop:win": "node scripts/vendor/mygo.mjs build -platform windows/amd64",
    "build:desktop:linux": "node scripts/vendor/mygo.mjs build -platform linux/amd64",
    "release:desktop:check": "node scripts/package/mygo-release.mjs --check-only",
    "release:desktop:verify": "node scripts/package/mygo-release.mjs --verify-artifacts",
    "release:desktop:build": "node scripts/package/mygo-release.mjs --build",
    "test:desktop:release": "node --test scripts/package/mygo-release*.test.mjs",
    "mpv:prepare": "node scripts/mpv/resources.mjs",
    "mpv:check": "node scripts/mpv/resources.mjs --check",
    "test:desktop:mpv": "python3 -m unittest discover -s scripts/mpv -p '*_test.py' && node --test scripts/mpv/*.test.mjs",
    "build:win": "pnpm run build:desktop:win",
    "build:mac": "pnpm run build:desktop:mac",
    "build:linux": "pnpm run build:desktop:linux"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.5.2",
    "@applemusic-like-lyrics/lyric": "^1.1.0",
    "@cap.js/widget": "0.1.58",
    "@imsyy/color-utils": "^1.0.2",
    "@material/material-color-utilities": "^0.3.0",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.5.0",
    "github-markdown-css": "^5.9.0",
    "go-captcha-vue": "^2.0.7",
    "hls.js": "^1.7.3",
    "i18next": "^25.10.10",
    "js-cookie": "^3.0.8",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "localforage": "^1.10.0",
    "lodash-es": "^4.18.1",
    "marked": "^16.4.2",
    "md5": "^2.3.0",
    "mygo-runtime": "0.8.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "plyr": "^3.8.5",
    "vue-dompurify-html": "^5.3.0",
    "vue-i18n": "^11.4.13"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "fast-glob": "^3.3.3",
    "naive-ui": "^2.45.3",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "terser": "^5.51.2",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^7.3.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vue-tsc": "3.3.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@applemusic-like-lyrics/core",
      "@applemusic-like-lyrics/lyric",
      "@applemusic-like-lyrics/vue",
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "sharp",
      "vue-demi"
    ]
  }
}
